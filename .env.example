# ==============================================================================
# SNAPGRAM ADMIN PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and adjust values for your environment.
# ==============================================================================

# [Required] Root address of the API Gateway (single entry point for all services).
# Used by Next.js rewrites (same-origin mode) and server-side proxy routes.
GATEWAY_URL=http://localhost:8080

# [Optional] Direct gateway URL override if bypassing same-origin rewrites.
# When omitted, browser requests use same-origin /api/* via Next.js rewrites.
NEXT_PUBLIC_API_URL=

# [Optional] Application display name used for the document title and header brand
NEXT_PUBLIC_APP_NAME="Snapgram Admin"

# [Required] Default application locale (en = English, vi = Vietnamese)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# [Optional] Client-side UI feature flag for two-factor authentication (TOTP).
# Note: Server is the ultimate source of truth via `requiresTwoFa` in login response.
NEXT_PUBLIC_ENABLE_2FA=true

# [Optional] MinIO S3 API endpoint for next/image remote patterns (defaults to http://localhost:9000)
NEXT_PUBLIC_MINIO_URL=http://localhost:9000

# ==============================================================================
# EXTERNAL TOOL LINKS (public - rendered as <a> links on the System Health page)
# All links are Optional; when omitted, the dashboard link is hidden or uses default.
# ==============================================================================

# [Optional] Kafka UI console
NEXT_PUBLIC_KAFKA_UI_URL=http://localhost:8089

# [Optional] MinIO S3 console
NEXT_PUBLIC_MINIO_CONSOLE_URL=http://localhost:9001

# [Optional] Mailpit web inbox
NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
