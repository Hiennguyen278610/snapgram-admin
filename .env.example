# ==============================================================================
# SNAPGRAM ADMIN PORTAL - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and adjust values for your environment.
# ==============================================================================

# [Required] Root address of the API Gateway (single entry point for all services)
NEXT_PUBLIC_API_URL=http://localhost:8080

# [Required] Gateway URL alias kept in sync with the Axios client configuration
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# [Optional] Application display name used for the document title and header brand
NEXT_PUBLIC_APP_NAME="Snapgram Admin"

# [Required] Default application locale (en = English, vi = Vietnamese)
NEXT_PUBLIC_DEFAULT_LOCALE=en

# [Optional] Feature flag enabling the two-factor authentication (TOTP) flow
NEXT_PUBLIC_ENABLE_2FA=true

# ==============================================================================
# SERVER-SIDE ONLY (never prefixed with NEXT_PUBLIC_) - consumed by the
# /api/health/[service] proxy route so internal service ports never reach the
# browser bundle.
# ==============================================================================

# [Required] Base URL of the API Gateway actuator endpoint
GATEWAY_URL=http://localhost:8080

# [Required] Base URL of the Auth service actuator endpoint
AUTH_SERVICE_URL=http://localhost:8081

# [Required] Base URL of the Content service actuator endpoint
CONTENT_SERVICE_URL=http://localhost:8084

# [Required] Base URL of the Media service actuator endpoint
MEDIA_SERVICE_URL=http://localhost:8085

# ==============================================================================
# EXTERNAL TOOL LINKS (public - rendered as <a> links on the System Health page)
# ==============================================================================

# [Required] Kafka UI console
NEXT_PUBLIC_KAFKA_UI_URL=http://localhost:8089

# [Required] MinIO S3 console
NEXT_PUBLIC_MINIO_CONSOLE_URL=http://localhost:9001

# [Required] Mailpit web inbox
NEXT_PUBLIC_MAILPIT_URL=http://localhost:8025
